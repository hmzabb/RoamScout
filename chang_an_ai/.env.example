# ============ 大模型（DeepSeek） ============
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ============ Embedding（硅基流动，DeepSeek 不提供 embedding 接口） ============
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ============ 外部 API（天气 / 景点 / 交通） ============
# 和风天气 API Key - 免费注册: https://id.qweather.com/#/register
# 免费版: 1000次/天，支持实时天气 + 7天预报 + 生活指数
QWEATHER_API_KEY=your-qweather-api-key
# 和风天气专属 API Host（控制台「项目管理」页，形如 abc123.re.qweatherapi.com）
# 新版控制台必须填写，否则旧域名会返回 403 Invalid Host；留空则使用旧域名
QWEATHER_API_HOST=
# 高德地图 API Key - 免费注册: https://lbs.amap.com/dev/key/app
# 免费版: 5000次/天，支持POI搜索 + 路径规划
AMAP_API_KEY=your-amap-api-key

# ============ LangSmith 监控（可选） ============
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT="chang_an_ai"

# ============ Java 后端（数据源） ============
JAVA_BASE_URL=http://127.0.0.1:8081
JAVA_TIMEOUT_SECONDS=3

# ============ RAG 参数 ============
RAG_RECALL_TOP_K=8
RAG_RERANK_TOP_K=4
RAG_MIN_SCORE=0.35
RAG_MAX_CONTEXT_CHARS=6000

# ============ Milvus 向量库（Docker standalone，gRPC 19530 / HTTP 9091） ============
MILVUS_URI=http://127.0.0.1:19530

# ============ 服务 ============
APP_HOST=127.0.0.1
APP_PORT=8000